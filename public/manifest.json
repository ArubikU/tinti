  "shortcuts": [
    {
      "name": "Nuevo Proyecto",
      "short_name": "Nuevo",
      "description": "Crear un nuevo proyecto de pixel art",
      "url": "/?action=new",
      "icons": [
        {
          "src": "/icons/shortcut-new-project.svg",
          "sizes": "96x96",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Explorar Galería",
      "short_name": "Explorar",
      "description": "Explorar proyectos de la comunidad",
      "url": "/?view=explore",
      "icons": [
        {
          "src": "/icons/shortcut-explore.svg",
          "sizes": "96x96",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Mis Proyectos",
      "short_name": "Proyectos",
      "description": "Ver mis proyectos guardados",
      "url": "/?view=dashboard",
      "icons": [
        {
          "src": "/icons/shortcut-projects.svg",
          "sizes": "96x96",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Abrir Imagen",
      "short_name": "Imagen",
      "description": "Abrir una imagen y convertirla a pixel art",
      "url": "/?action=import-image",
      "icons": [
        {
          "src": "/icons/shortcut-image.svg",
          "sizes": "96x96",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Abrir Archivo .tin",
      "short_name": "Archivo",
      "description": "Abrir un archivo .tin guardado",
      "url": "/?action=import-tin",
      "icons": [
        {
          "src": "/icons/shortcut-tin.svg",
          "sizes": "96x96",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/octet-stream": [".tin"]
      },
      "icons": [
        {
          "src": "/icons/shortcut-tin.svg",
          "sizes": "96x96",
          "type": "image/svg+xml"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".gif", ".bmp", ".webp"]
      },
      "icons": [
        {
          "src": "/icons/shortcut-image.svg",
          "sizes": "96x96",
          "type": "image/svg+xml"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
