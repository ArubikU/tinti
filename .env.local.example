# Copia este archivo a .env.local y configura tus valores reales

# Ably Configuration - Obtén estas keys desde https://ably.com
NEXT_PUBLIC_ABLY_API_KEY=your-ably-public-api-key-here
ABLY_API_KEY=your-ably-private-api-key-here

# Database Configuration (opcional)
DATABASE_URL=your-database-url-here

# Auth Configuration (opcional)
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
